// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored; this template is committed.
//
// NOTE: xcconfig treats "//" as a comment, so write URLs as
//   https:/$()/your-project.supabase.co

SUPABASE_URL =
SUPABASE_ANON_KEY =

// Backend the app uploads video to (no trailing slash).
//   Deployed (SIG-59):  https:/$()/sightline-eyw3.onrender.com
//   Local Docker:       http:/$()/<your Mac's Wi-Fi IP>:8000
API_BASE_URL =

// DEBUG ONLY. A test user from Supabase -> Authentication -> Users.
// The debug "Upload test clip" button signs in as this user to get the
// access token the backend requires, until the real login screens land.
// Avoid "//" and "$" in the password (xcconfig treats them specially).
TEST_USER_EMAIL =
TEST_USER_PASSWORD =

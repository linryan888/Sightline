<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Meta Wearables Device Access Toolkit (glasses). Xcode merges these
	     keys into the generated Info.plist. Mirrors Meta's CameraAccess sample. -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>sightline://</string>
		<!-- Empty = Developer Mode. Set the real ID and ClientToken from the
		     Wearables Developer Center before shipping. -->
		<key>MetaAppID</key>
		<string></string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<!-- Lets the Meta AI app call back into SightLine after pairing. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sightline</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<!-- Bluetooth Classic link to the glasses; camera streaming needs this. -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to your Meta glasses.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Needed to connect to your Meta glasses.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lets your phone connect to your glasses over Wi-Fi.</string>
	<!-- Lets the share sheet's "Save Image" / "Save Video" add to Photos. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Saves photos and videos from your glasses to your library.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
</dict>
</plist>
